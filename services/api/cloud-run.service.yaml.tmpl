apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: sakhicircle-api
  namespace: "859217028205"
  labels:
    cloud.googleapis.com/location: asia-south1
  annotations:
    run.googleapis.com/ingress: all
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/minScale: "0"
        autoscaling.knative.dev/maxScale: "2"
    spec:
      containerConcurrency: 20
      timeoutSeconds: 420
      serviceAccountName: sakhi-runtime@patchamomma-2026-505415.iam.gserviceaccount.com
      containers:
        - image: asia-south1-docker.pkg.dev/patchamomma-2026-505415/sakhi-containers/sakhicircle-api@sha256:${IMAGE_DIGEST}
          ports:
            - name: http1
              containerPort: 8080
          env:
            - name: SAKHI_APP_ENV
              value: production
            - name: SAKHI_DEMO_MODE
              value: "false"
            - name: SAKHI_ADAPTER_MODE
              value: production
            - name: SAKHI_JOURNEY_ADAPTER_MODE
              value: gemini_adk
            - name: SAKHI_JOURNEY_ATTEMPT_TIMEOUT_SECONDS
              value: "30"
            - name: SAKHI_PROFILE_EXTRACTION_TIMEOUT_SECONDS
              value: "10"
            - name: SAKHI_PAID_API_CALLS_ENABLED
              value: "true"
            - name: SAKHI_GEMINI_MODEL
              value: gemini-3.7-flash
            - name: SAKHI_JOURNEY_GEMINI_MODEL
              value: gemini-2.5-flash
            - name: SAKHI_GEMINI_BACKEND
              value: vertex_ai
            - name: SAKHI_GEMINI_LOCATION
              value: global
            - name: GOOGLE_GENAI_USE_VERTEXAI
              value: "true"
            - name: GOOGLE_CLOUD_PROJECT
              value: patchamomma-2026-505415
            - name: GOOGLE_CLOUD_LOCATION
              value: global
            - name: SAKHI_FIREBASE_PROJECT_ID
              value: patchamomma-2026-505415
            - name: SAKHI_FIREBASE_APP_ID
              value: ${FIREBASE_APP_ID}
            - name: SAKHI_FIRESTORE_DATABASE_ID
              value: (default)
            - name: SAKHI_ALLOWED_ORIGINS
              value: '${ALLOWED_ORIGINS}'
            - name: SAKHI_ANALYTICS_LOCATION
              value: asia-south1
            - name: SAKHI_ANALYTICS_PRIVATE_DATASET_ID
              value: sakhi_analytics
            - name: SAKHI_ANALYTICS_TABLE_ID
              value: checkpoint_events_v1
            - name: SAKHI_ANALYTICS_REPORTING_DATASET_ID
              value: sakhi_reporting
            - name: SAKHI_ANALYTICS_REPORTING_VIEW_ID
              value: checkpoint_metrics_v1
            - name: SAKHI_ANALYTICS_QUEUE_ID
              value: analytics-delivery
            - name: SAKHI_ANALYTICS_TASK_SERVICE_ACCOUNT
              value: sakhi-task-delivery@patchamomma-2026-505415.iam.gserviceaccount.com
            - name: SAKHI_ANALYTICS_TASK_AUDIENCE
              value: ${ANALYTICS_TASK_AUDIENCE}
            - name: SAKHI_ANALYTICS_HMAC_SECRET_NAME
              value: sakhi-analytics-hmac-key
            - name: SAKHI_ANALYTICS_HMAC_SECRET_VERSIONS
              value: '["${ANALYTICS_HMAC_SECRET_VERSION}"]'
            - name: SAKHI_ANALYTICS_CURRENT_HMAC_SECRET_VERSION
              value: '${ANALYTICS_HMAC_SECRET_VERSION}'
          resources:
            limits:
              cpu: "1"
              memory: 512Mi
