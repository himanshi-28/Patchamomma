{
  "name": "@sakhicircle/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "build": "expo export --platform android --output-dir dist/android",
    "doctor": "expo-doctor",
    "prebuild:check": "expo prebuild --no-install --clean",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "maestro test .maestro",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.1",
    "expo": "~56.0.20",
    "expo-constants": "~56.0.24",
    "expo-dev-client": "~56.0.24",
    "expo-font": "~56.0.7",
    "expo-linking": "~56.0.17",
    "expo-router": "~56.2.19",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "lucide-react-native": "^1.33.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.0",
    "@types/react": "~19.2.2",
    "expo-doctor": "^1.20.2",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
